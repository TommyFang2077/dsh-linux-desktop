+/**
+ * Drop superseded Host authentication cookies from the Electron session.
+ *
+ * The Host names its cookie after the launch authority, which includes the
+ * ephemeral port it listens on, so every launch mints a distinct cookie and
+ * none supersedes the last. Electron keeps them all until they expire, and the
+ * accumulated `Cookie` request header eventually exceeds the Host's 16 KiB
+ * request-head limit, which surfaces only as a failed launch. Removing every
+ * older `dsh-auth-` cookie before the exchange keeps the header to one entry.
+ *
+ * @param startUrl - Launch URL from the running Host; its host selects the jar entries.
+ * @param jar - Electron session cookies, or nothing when the host cannot clean.
+ * @returns Completion once superseded cookies are gone.
+ */
+export async function forgetSupersededHostCookies(
+  startUrl: string,
+  jar: Pick<Electron.Cookies, 'get' | 'remove'> | undefined,
+): Promise<void> {
+  if (jar === undefined) return
+  const stale = (await jar.get({ url: startUrl })).filter(cookie => cookie.name.startsWith('dsh-auth-'))
+  await Promise.all(stale.map(cookie => jar.remove(startUrl, cookie.name)))
+}
