+    </> : version !== undefined && t('general.currentVersion', { version })}
+    {failure !== '' && <div role="alert">{t('general.versionCheckFailed')}: {failure}</div>}
+    {getWorkbenchVersions !== undefined && <button type="button" disabled={busy} onClick={() => { void refresh() }}>
+      {busy ? t('general.checkingVersions') : t('general.checkVersions')}
+    </button>}
+    {openWorkbenchUpdates !== undefined && <button type="button" onClick={() => {
