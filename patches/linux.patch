new file mode 100644
--- /dev/null
+++ b/packages/core/agent/src/update-admission.ts
@@ -0,0 +1,62 @@
+import { AsyncLocalStorage } from 'node:async_hooks'
+import { isPromise } from 'node:util/types'
+
+/** Reversible process-local admission, shared by managed task producers. */
+export class UpdateAdmissionGate {
+  readonly version: 1 = 1
+  private owner: string | undefined
+  private pending = 0
+  private unknown = false
+  private readonly permits = new AsyncLocalStorage<{ active: boolean }>()
+  private readonly listeners = new Set<() => void>()
+  get active(): number { return this.pending + (this.unknown ? 1 : 0) }
+  get frozen(): boolean { return this.owner !== undefined }
+  markUnknown(): void { this.unknown = true }
+  assertOpen(): void {
+    if (this.frozen && this.permits.getStore()?.active !== true) {
+      throw new Error('desktop update: task admission is frozen; retry after the update')
+    }
+  }
+  run<T>(operation: () => T): T {
+    this.assertOpen()
+    const permit = { active: true }
+    this.pending++
+    const release = (): void => {
+      if (!permit.active) return
+      permit.active = false
+      this.pending--
+    }
+    try {
+      const result = this.permits.run(permit, operation)
+      try {
+        if (isPromise(result)) {
+          void Promise.prototype.then.call(result, release, release)
+        } else if (result !== null && (typeof result === 'object' || typeof result === 'function')
+          && typeof (result as { then?: unknown }).then === 'function') {
+          void Promise.resolve(result).then(release, release)
+        } else release()
+      } catch {
+        this.unknown = true
+        release()
+      }
+      return result
+    } catch (error) { release(); throw error }
+  }
+  freeze(token: string): void {
+    if (!token) throw new Error('desktop update: missing admission token')
+    if (this.owner !== undefined && this.owner !== token) throw new Error('desktop update: admission already owned')
+    this.owner = token
+  }
+  release(token: string): boolean {
+    if (this.owner !== token) return false
+    this.owner = undefined
+    for (const listener of this.listeners) {
+      try { listener() } catch { /* A failed observer must not leave other producers frozen. */ }
+    }
+    return true
+  }
+  onResume(listener: () => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+}
